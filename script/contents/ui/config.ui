<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>HyprKWinConfig</class>
 <widget class="QWidget" name="HyprKWinConfig">
  <layout class="QVBoxLayout" name="rootLayout">
   <item><widget class="QLabel" name="introLabel"><property name="text"><string>Hyprland options, same names and defaults. After saving, changes apply right away; if not, turn the script off and on.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item>
    <widget class="QTabWidget" name="tabs">
     <widget class="QWidget" name="tabGeneral">
      <attribute name="title"><string>General</string></attribute>
      <layout class="QFormLayout" name="formGeneral">
       <item row="0" column="0"><widget class="QLabel" name="labelLayout"><property name="text"><string>Default layout (general:layout)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item row="0" column="1"><widget class="QComboBox" name="kcfg_Layout"><item><property name="text"><string>dwindle</string></property></item><item><property name="text"><string>master</string></property></item><item><property name="text"><string>scrolling</string></property></item><item><property name="text"><string>monocle</string></property></item></widget></item>
       <item row="1" column="0"><widget class="QLabel" name="labelTilingDefault"><property name="text"><string>Desktops that start tiled (Super+T switches any desktop until you log out)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item row="1" column="1"><widget class="QComboBox" name="kcfg_TilingDefault"><item><property name="text"><string>all desktops</string></property></item><item><property name="text"><string>none (normal KDE until toggled)</string></property></item><item><property name="text"><string>only the ones listed below</string></property></item></widget></item>
       <item row="2" column="0"><widget class="QLabel" name="labelTiledDesktops"><property name="text"><string>Desktop numbers that tile; the rest start in gaming mode (default: desktop 2 is for gaming)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item row="2" column="1"><widget class="QLineEdit" name="kcfg_TiledDesktops"/></item>
       <item row="3" column="0"><widget class="QLabel" name="labelGapsIn"><property name="text"><string>Gaps between windows (general:gaps_in)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item row="3" column="1"><widget class="QSpinBox" name="kcfg_GapsIn"><property name="minimum"><number>0</number></property><property name="maximum"><number>200</number></property></widget></item>
       <item row="4" column="0"><widget class="QLabel" name="labelGapsOut"><property name="text"><string>Gaps to screen edges (general:gaps_out)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item row="4" column="1"><widget class="QSpinBox" name="kcfg_GapsOut"><property name="minimum"><number>0</number></property><property name="maximum"><number>200</number></property></widget></item>
       <item row="5" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_SmartGaps"><property name="text"><string>No gaps when only one window is tiled</string></property></widget></item>
       <item row="6" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_HideTitlebars"><property name="text"><string>Hide titlebars on tiled windows (Hyprland has none)</string></property></widget></item>
       <item row="7" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_FloatAbove"><property name="text"><string>Keep floating windows above tiled ones</string></property></widget></item>
       <item row="8" column="0"><widget class="QLabel" name="labelFocusPreferredMethod"><property name="text"><string>Directional focus picks (binds:focus_preferred_method)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item row="8" column="1"><widget class="QComboBox" name="kcfg_FocusPreferredMethod"><item><property name="text"><string>most recently focused</string></property></item><item><property name="text"><string>longest shared edge</string></property></item></widget></item>
       <item row="9" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_MonitorFallback"><property name="text"><string>Move/focus to the next monitor at the edge (binds:window_direction_monitor_fallback)</string></property></widget></item>
       <item row="10" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_NoFocusFallback"><property name="text"><string>Don&#x27;t wrap focus (general:no_focus_fallback)</string></property></widget></item>
       <item row="11" column="0"><widget class="QLabel" name="labelResizeStep"><property name="text"><string>Keyboard resize/move step in pixels</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item row="11" column="1"><widget class="QSpinBox" name="kcfg_ResizeStep"><property name="minimum"><number>5</number></property><property name="maximum"><number>500</number></property></widget></item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabRules">
      <attribute name="title"><string>Rules</string></attribute>
      <layout class="QFormLayout" name="formRules">
